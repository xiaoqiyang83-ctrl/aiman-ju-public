# 服务配置
PORT=3000
NODE_ENV=development

# JWT认证密钥（生产环境请使用复杂随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Vidu API配置
# 获取地址: https://www.vidu.cn
# 不填或留空将使用模拟模式
VIDU_API_KEY=

# AI服务配置
# 支持的provider: openai-compatible (硅基流动等), ernie (文心一言)
AI_PROVIDER=openai-compatible

# 硅基流动 / OpenAI兼容配置
# 获取地址: https://siliconflow.cn
AI_API_KEY=
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 文心一言配置（百度智能云）
# 获取地址: https://cloud.baidu.com/product/wenxinworkshop
ERNIE_API_KEY=
ERNIE_SECRET_KEY=
ERNIE_MODEL=ernie-3.5-8k

# 数据库配置（可选，默认使用SQLite）
# DATABASE_PATH=./data/manju.db

# 日志配置
LOG_LEVEL=info
